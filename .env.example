# Copy to .env and fill in real values before running:
#   docker compose -f docker-compose.prod.yml up -d

# Postgres credentials — used by both the db container and the app's DATABASE_URL.
POSTGRES_USER=tripmap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tripmap

# Allowed CORS origins as a JSON array, e.g. ["https://tripmap.example.com"].
CORS_ORIGINS=["http://localhost:8000"]

# App image tag. Defaults to vingii/tripmap:latest; pin to a release for stability.
# TRIPMAP_IMAGE=vingii/tripmap:v0.1.0

# Host port the app is exposed on.
# TRIPMAP_PORT=8000

# Geocoding (Nominatim). Defaults to the public OpenStreetMap instance; point this
# at a self-hosted Nominatim to avoid the public usage policy / rate limits.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# OIDC (Authentik). Protected endpoints verify bearer tokens against the
# provider's JWKS (RS256; signature + issuer + audience). Issuer and audience are
# required for any request to authenticate. See docs/authentik-sso.md for how to
# create the provider/application and obtain these values.
#
# OIDC_ISSUER  — the provider's issuer URL, WITH a trailing slash.
# OIDC_AUDIENCE — the provider's Client ID (must equal the token's `aud` claim).
# OIDC_JWKS_URL — leave blank to auto-discover from the issuer's
#                 /.well-known/openid-configuration; set only to override.
OIDC_ISSUER=https://auth.example.com/application/o/tripmap/
OIDC_AUDIENCE=tripmap
# OIDC_JWKS_URL=https://auth.example.com/application/o/tripmap/jwks/

# Mapy.com (Seznam) tiles. Optional — when set, the flat map offers Mapy.com as
# an alternative base layer; when blank the option is hidden and the map uses
# OpenStreetMap only. Get a key at https://developer.mapy.com/. The key is
# served to the browser via /api/config, so restrict it to your own domain in
# the Mapy.com dashboard.
# MAPY_API_KEY=
